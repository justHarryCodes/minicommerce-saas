# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/shopforge

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Firebase (Client SDK — public) ──────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (Server SDK — private) ───────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── App ─────────────────────────────────────────────────────────────────────
# Single source of truth for Paystack callback URLs. To move to a new domain,
# change ONLY this value — no other code or config needs to change.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Paystack ────────────────────────────────────────────────────────────────
# Webhook URL to register in the Paystack dashboard (Settings → API Keys & Webhooks):
#   ${NEXT_PUBLIC_APP_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=shopforge
# Optional API key/secret (only needed for signed uploads / management)
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── AI assist (optional — features stay disabled/hidden until these are set) ─
# Both providers retire/rename models over time — GROQ_MODEL and GEMINI_MODEL
# below went dead once already (silently — every AI call just started
# failing, since src/lib/ai/{groq,gemini}.ts fall back to these same values
# when the env var is unset). If AI features stop working, check the
# provider's current catalog before assuming it's a code bug:
#   Groq:   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#   Gemini: curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
#
# Groq: https://console.groq.com/keys — used for product-description writing
# and the storefront shopping assistant (fast, cheap text generation).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini: https://aistudio.google.com/apikey — used for product-photo
# category suggestion (vision analysis only, not image editing). Uses the
# "-latest" alias deliberately so it keeps resolving to Google's current
# recommended Flash model rather than going dead again.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─── Web Push (vendor + admin browser/PWA notifications) ────────────────────
# Generate a keypair once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the SAME value —
# the public key is safe to expose client-side by design (same pattern as
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY above), it's how the browser's push
# service verifies sends actually come from this server's private key.
# VAPID_SUBJECT must be a mailto: address or https: URL identifying this
# app to push services (Chrome/Firefox may contact it if something's wrong
# with how this server is sending pushes) — update to a real support inbox.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@awarizon.shop
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Sentry (optional — leave blank to keep error tracking disabled) ─────────
# DSN: https://sentry.io — Settings → Projects → (your project) → Client Keys.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed if you also want source maps uploaded on build — safe to leave
# blank, the build just skips that step with a warning.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
